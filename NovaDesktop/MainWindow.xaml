<Window x:Class="NovaDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nova Desktop">
  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <NavigationView x:Name="Nav" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" PaneDisplayMode="Left" SelectionChanged="Nav_SelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Home" Tag="home" Icon="Home" />
        <NavigationViewItem Content="Launcher" Tag="launcher" Icon="Find" />
        <NavigationViewItem Content="Workspaces" Tag="workspaces" Icon="View" />
        <NavigationViewItem Content="Appearance" Tag="appearance" Icon="Edit" />
        <NavigationViewItem Content="About" Tag="about" Icon="Help" />
      </NavigationView.MenuItems>
      <Grid Padding="28" RowDefinitions="Auto,*" RowSpacing="20">
        <StackPanel Spacing="6">
          <TextBlock x:Name="PageTitle" Text="Welcome to Nova" FontSize="30" FontWeight="SemiBold" />
          <TextBlock x:Name="PageSubtitle" Text="A calmer way to use Windows." Opacity="0.7" />
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="16">
          <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="16" Padding="24">
            <StackPanel Spacing="12">
              <TextBlock Text="Your desktop, your way" FontSize="22" FontWeight="SemiBold" />
              <TextBlock x:Name="Description" Text="Nova works alongside Windows Explorer. Start with a theme and workspace preset." TextWrapping="Wrap" />
              <TextBlock Text="Theme" FontWeight="SemiBold" />
              <ComboBox x:Name="ThemeChoice" SelectedIndex="0" SelectionChanged="ThemeChoice_SelectionChanged">
                <ComboBoxItem Content="System" Tag="system" />
                <ComboBoxItem Content="Midnight" Tag="dark" />
                <ComboBoxItem Content="Frost" Tag="light" />
              </ComboBox>
              <TextBlock Text="Workspace" FontWeight="SemiBold" />
              <ComboBox x:Name="WorkspaceChoice" SelectedIndex="0" SelectionChanged="WorkspaceChoice_SelectionChanged">
                <ComboBoxItem Content="Home" /><ComboBoxItem Content="Student" />
                <ComboBoxItem Content="Work" /><ComboBoxItem Content="Developer" />
              </ComboBox>
              <TextBlock x:Name="Status" Text="Ready" Opacity="0.7" />
            </StackPanel>
          </Border>
          <TextBlock Text="Early preview: the launcher, dock, and shell integrations are planned features, not yet active." TextWrapping="Wrap" Opacity="0.65" />
        </StackPanel>
      </Grid>
    </NavigationView>
  </Grid>
</Window>